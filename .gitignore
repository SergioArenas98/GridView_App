# ==============================
# Edge API (Cloudflare Worker)
# ==============================

node_modules/
services/edge-api/dist/
.wrangler/
.dev.vars

# Throwaway wrangler-generated types (regenerated by `validate:worker-config`
# to sanity-check wrangler config; wrangler does not create the `.wrangler/`
# parent dir on a fresh checkout, so the artifact is generated in place here).
services/edge-api/worker-configuration.d.ts

# Media dry-run output: generated variants, the manifest fragment and the object
# inventory. Regenerated on demand and never committed - a published asset lives
# in R2, not in Git.
services/edge-api/.media-out/

/backend/

# Golden-test diff artifacts written by `flutter test` on a mismatch. They are
# inspection output, never a committed baseline.
test/**/failures/

# ==============================
# AI agent tooling - local & generated state, never commit
# ==============================
#
# Optional developer/agent tooling only (see docs/tooling/AI_AGENT_TOOLING.md).
# None of this is application runtime, build or deployment state.
#
# Graphify knowledge-graph output: ~23 MB of generated graphs, reports, HTML
# and AST/semantic caches. Regenerated by `graphifyy`; contains absolute local
# paths, machine metadata and usage telemetry. Never commit.
/graphify-out/
#
# Local Claude Code / tooling settings, hooks and the regenerable third-party
# Graphify skill copy. Machine-specific; recreated by tool installation.
/.claude/settings.json
/.claude/settings.json.graphify-bak
/.claude/settings.local.json
/.claude/scheduled_tasks.lock
/.claude/scheduled_tasks.json
/.claude/skills/graphify/
