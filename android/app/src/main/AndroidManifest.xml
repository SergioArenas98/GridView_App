<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Firebase collection policy: the DEFAULT is off, for every flavor.

             A default, not a per-launch guarantee, and not an enforcement
             mechanism. Read that carefully before relying on it: these flags
             decide what happens on a fresh installation that has never opted
             in. They are not re-applied at every process start, and they do not
             override a choice made at runtime.

             This is a native boundary, and it exists because the Dart policy
             cannot be one. Android instantiates FirebaseInitProvider (and the
             Crashlytics, Performance, Sessions, Installations and Remote Config
             component registrars that ship in every flavor) during application
             startup, before any Dart code runs. A Dart-side eligibility check
             therefore cannot prevent native collection from beginning - it can
             only decide what the Dart adapters do afterwards.

             The lifecycle, stated exactly:

               * fresh installation, any flavor - collection is OFF, because
                 these defaults apply and nothing has overridden them;
               * an eligible PRODUCTION build activates at runtime and calls
                 setCrashlyticsCollectionEnabled(true) and
                 setPerformanceCollectionEnabled(true) - collection is enabled,
                 and the platform SDKs PERSIST that choice at a HIGHER priority
                 than these manifest values;
               * every later production launch on that installation therefore
                 begins with collection already enabled, BEFORE any Dart code
                 runs. Do not write that the packaged SDKs are inert at process
                 start in every flavor: that is true only until the first
                 successful production activation.

             Dev and staging are structurally isolated from all of this. They
             carry the .dev and .staging application-ID suffixes, so they are
             separate installations with separate storage; they own no
             google-services.json; and they are ineligible, so the activation
             that writes the override is never called for them. No override can
             ever exist for a non-production installation.

             See docs/technical/GridView_Observability.md section 4.1.

             The missing google_app_id in dev and staging is a second, separate
             obstacle - the default FirebaseApp cannot initialize without it -
             but it is a consequence of configuration being absent, not a policy.
             These flags are the default policy, and they stay correct even if a
             configuration file is introduced later by accident.

             firebase_performance_collection_deactivated is deliberately NOT
             used: it is permanent and cannot be reversed at runtime, which would
             also disable the production build this integration exists for. -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_performance_collection_enabled"
            android:value="false" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="mailto" />
        </intent>
    </queries>
</manifest>
