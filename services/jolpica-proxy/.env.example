# Non-secret settings. The listener is always 127.0.0.1.
JOLPICA_PROXY_PORT=8788
JOLPICA_PROXY_TIMEOUT_MS=8000
JOLPICA_PROXY_MAX_CONCURRENT=4
# Optional: an IPv4 address actually assigned to this machine's interface.
# JOLPICA_PROXY_LOCAL_IPV4=192.0.2.10

# Provide exactly one secret source. Do not put real credentials in this file.
# Production uses systemd LoadCredential; local runs can read an external file.
# JOLPICA_PROXY_TOKEN_FILE=/absolute/path/outside/repository/proxy-token
# JOLPICA_PROXY_TOKEN may alternatively be provided through the process environment.
