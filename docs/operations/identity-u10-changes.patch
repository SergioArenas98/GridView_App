+ * U10: the pinned driver-profile view required-identity closure reads.
+ *
+ * Built once from an **admitted** `IdentityRunContext`. Every lookup answers
+ * from that context's immutable profiles and verified bindings, so a catalog
+ * activation after admission can never change what one run supplements, and no
+ * lookup reaches a current head, a namespace or the network.
+ */
+
+import type { CuratedDriver } from '../../providers/jolpica/curated-participants';
+import {
+  assertIdentityRunContext,
+  type IdentityRunContext,
+} from './run-context';
+
+/**
+ * Structurally the coordination package's `PinnedDriverProfiles`; declared
+ * here so this module adds no import edge into that package (the
+ * coordination-containment consumer list stays exact).
+ */
+export interface PinnedDriverProfileView {
+  readonly catalogHash: string;
+  driverById(id: string): CuratedDriver | null;
+  isVerifiedSeasonDriver(id: string): boolean;
+}
+
+export function pinnedDriverProfiles(
+  context: IdentityRunContext,
+): PinnedDriverProfileView {
+  assertIdentityRunContext(context);
+  const bound = new Set(
+    context.verifiedBindings
+      .filter(
+        (b) =>
+          b.key.season === context.season &&
+          b.key.source === 'jolpica' &&
+          b.key.entity === 'driver',
+      )
+      .map((b) => b.targetId),
+  );
+  return Object.freeze({
+    catalogHash: context.catalogHash,
+    driverById: (id: string) => context.participants.driverById(id),
+    isVerifiedSeasonDriver: (id: string) => bound.has(id),
+  });
+}
diff --git a/services/edge-api/src/providers/coordination/season-identity-closure.ts b/services/edge-api/src/providers/coordination/season-identity-closure.ts
new file mode 100644
index 0000000..c557f84
--- /dev/null
+++ b/services/edge-api/src/providers/coordination/season-identity-closure.ts
@@ -0,0 +1,219 @@
+/**
+ * U10: required driver identity closure (design §8.2, ADR 0030 D2).
+ *
+ * Under the explicit `optional-drivers` policy a provider driver inventory may
+ * omit a driver that a selected race result or standings row still requires,
+ * because the inventory and the classifications are separate provider
+ * resources. This module closes the season's public driver set over every
+ * required reference, using **only** profiles that are already verified in the
+ * same pinned catalog revision the run admitted:
+ *
+ * ```text
+ * required = driver IDs of every selected race result entry
+ *          ∪ every non-null selected fastestLap.driverId
+ *          ∪ every selected driver standing
+ *          ∪ every derived participation span driver
+ *          ∪ every non-null constructor-lineup driver reference
+ * output   = verified inventory profiles (provider order)
+ *          ++ (required − inventory), in exact canonical-ID order
+ * ```
+ *
+ * What it never does:
+ *
+ * - synthesize an identity, a fallback profile or a profile from provider
+ *   names - a required ID without a complete pinned profile is a refusal;
+ * - add every curated driver, or any driver nothing requires;
+ * - create, extend or infer a participation span, a team or a constructor
+ *   association: it returns profiles only, and span derivation stays
+ *   `deriveDriverSeasonEntries`'s;
+ * - read a mutable catalog head, the network or a clock.
+ *
+ * Pure and deterministic. Problems are closed codes and never carry a value.
+ */
+
+import type {
+  ConstructorSeasonEntry,
+  Driver,
+  DriverSeasonEntry,
+  DriverStanding,
+  RaceResult,
+} from '../../contract/types';
+import { validateDriver } from '../../contract/normalized';
+import type { DriverInventoryPolicy } from '../../identity/inventory/model';
+
+/**
+ * The verified driver profiles of one pinned catalog revision, for one season.
+ *
+ * Built once from the admitted `IdentityRunContext` (see
+ * `identity/catalog/closure-profiles.ts`), never from a current head.
+ */
+export interface PinnedDriverProfiles {
+  /** The catalog hash of the admitted run context. */
+  readonly catalogHash: string;
+  /** A fresh copy of the pinned canonical profile, or `null`. */
+  driverById(id: string): Omit<Driver, 'media'> | null;
+  /**
+   * Whether the pinned revision holds a verified Jolpica driver binding for
+   * this season targeting `id`. A profile without one was never admitted as a
+   * season identity and cannot be supplemented.
+   */
+  isVerifiedSeasonDriver(id: string): boolean;
+}
+
+/** The trusted identity inputs assembly receives for one whole run. */
+export interface SeasonIdentityContext {
+  /** The run's single admitted inventory policy. */
+  readonly policy: DriverInventoryPolicy;
+  readonly profiles: PinnedDriverProfiles;
+}
+
+export interface SeasonIdentityClosureInput {
+  /** The verified inventory profiles, in provider order. */
+  readonly inventoryDrivers: readonly Driver[];
+  /** Every selected race classification. */
+  readonly results: readonly RaceResult[];
+  readonly driverStandings: readonly DriverStanding[];
+  /** The derived participation spans (and any contributed entries). */
+  readonly driverEntries: readonly DriverSeasonEntry[];
+  readonly constructorEntries: readonly ConstructorSeasonEntry[];
+  readonly profiles: PinnedDriverProfiles;
+}
+
+/** Closed problem codes. Never an identifier. */
+export const identityClosureProblems = [
+  /** Two inventory profiles share one canonical identity. */
+  'duplicate-inventory-driver',
+  /** An inventory profile differs from the pinned profile of its identity. */
+  'inventory-profile-mismatch',
+  /** A required identity has no pinned profile. */
+  'missing-profile',
+  /** The pinned profile answers for a different identity. */
+  'contradictory-profile',
+  /** The pinned profile fails deep driver validation. */
+  'invalid-profile',
+  /** The identity has no verified season binding in the pinned revision. */
+  'unbound-profile',
+] as const;
+
+export type IdentityClosureProblem = (typeof identityClosureProblems)[number];
+
+export type SeasonIdentityClosure =
+  | {
+      readonly ok: true;
+      /** Inventory profiles, then supplemented profiles in exact-ID order. */
+      readonly drivers: readonly Driver[];
+      /** Exact-ID order; the supplemented subset of `drivers`. */
+      readonly supplemented: readonly string[];
+    }
+  | { readonly ok: false; readonly problem: IdentityClosureProblem };
+
+/** Exact UTF-16 code-unit order: locale-independent and total. */
+function exactOrder(left: string, right: string): number {
+  return left < right ? -1 : left > right ? 1 : 0;
+}
+
+/** The required driver identity set, exactly as design §8.2 defines it. */
+export function requiredDriverIds(
+  input: Omit<SeasonIdentityClosureInput, 'inventoryDrivers' | 'profiles'>,
+): ReadonlySet<string> {
+  const required = new Set<string>();
+  for (const result of input.results) {
+    for (const entry of result.entries) required.add(entry.driverId);
+    const fastest = result.fastestLap?.driverId ?? null;
+    if (fastest !== null) required.add(fastest);
+  }
+  for (const standing of input.driverStandings) required.add(standing.driverId);
+  for (const entry of input.driverEntries) required.add(entry.driverId);
+  for (const entry of input.constructorEntries) {
+    // A null lineup is "GridView records no lineup", never a reference.
+    for (const driverId of entry.driverLineup ?? []) required.add(driverId);
+  }
+  return required;
+}
+
+/** One pinned profile, deep-validated, or the closed reason it is unusable. */
+function pinnedProfile(
+  profiles: PinnedDriverProfiles,
+  id: string,
+): Driver | IdentityClosureProblem {
+  const profile = profiles.driverById(id);
+  if (profile === null) return 'missing-profile';
+  // The same media policy every Jolpica profile projection applies.
+  const driver = { ...profile, media: null } as Driver;
+  if (driver.id !== id) return 'contradictory-profile';
+  if (validateDriver(driver, 'driver').length > 0) return 'invalid-profile';
+  if (!profiles.isVerifiedSeasonDriver(id)) return 'unbound-profile';
+  return driver;
+}
+
+/**
+ * Structural equality, independent of key order. Every `Driver` field is a
+ * scalar today; comparing structurally keeps a future array or object field
+ * from turning every inventory profile into a spurious mismatch.
+ */
+function sameValue(left: unknown, right: unknown): boolean {
+  if (left === right) return true;
+  if (
+    typeof left !== 'object' ||
+    typeof right !== 'object' ||
+    left === null ||
+    right === null ||
+    Array.isArray(left) !== Array.isArray(right)
+  )
+    return false;
+  const keys = Object.keys(right);
+  return (
+    Object.keys(left).length === keys.length &&
+    keys.every(
+      (key) =>
+        Object.hasOwn(left, key) &&
+        sameValue(
+          (left as Record<string, unknown>)[key],
+          (right as Record<string, unknown>)[key],
+        ),
+    )
+  );
+}
+
+function sameProfile(left: Driver, right: Driver): boolean {
+  return sameValue(left, right);
+}
+
+/**
+ * Closes the season's public driver set over every required reference.
+ *
+ * Every inventory profile is re-checked against the pinned profile of its
+ * identity, so a coordination payload can never disagree with the run's
+ * catalog. Every supplemented profile is loaded from the same pinned profiles
+ * and deep-validated here, not only those that passed through a provider port.
+ */
+export function closeSeasonDriverIdentities(
+  input: SeasonIdentityClosureInput,
+): SeasonIdentityClosure {
+  const inventoryIds = new Set<string>();
+  const drivers: Driver[] = [];
+  for (const driver of input.inventoryDrivers) {
+    if (inventoryIds.has(driver.id))
+      return { ok: false, problem: 'duplicate-inventory-driver' };
+    inventoryIds.add(driver.id);
+    const pinned = pinnedProfile(input.profiles, driver.id);
+    if (typeof pinned === 'string') return { ok: false, problem: pinned };
+    if (!sameProfile(driver, pinned))
+      return { ok: false, problem: 'inventory-profile-mismatch' };
+    drivers.push(pinned);
+  }
+
+  const supplemented = [...requiredDriverIds(input)]
+    .filter((id) => !inventoryIds.has(id))
+    .sort(exactOrder);
+  for (const id of supplemented) {
+    const pinned = pinnedProfile(input.profiles, id);
+    if (typeof pinned === 'string') return { ok: false, problem: pinned };
+    drivers.push(pinned);
+  }
+  return {
+    ok: true,
+    drivers: Object.freeze(drivers),
+    supplemented: Object.freeze(supplemented),
+  };
+}
diff --git a/services/edge-api/test/identity/catalog/inventory-policy.test.ts b/services/edge-api/test/identity/catalog/inventory-policy.test.ts
new file mode 100644
index 0000000..1d6c595
--- /dev/null
+++ b/services/edge-api/test/identity/catalog/inventory-policy.test.ts
@@ -0,0 +1,286 @@
+/**
+ * U10: whole-run inventory policy selection, durable pin provenance and
+ * batch-v2 reference discrimination (design §6.3, §9.2, §11.1; ADR 0030 D4,
+ * ADR 0031 D2/D4).
+ *
+ * Pure and in-memory. The namespace doubles record what would be sent and
+ * never reach a network; the global `fetch` throws.
+ */
+
+import { readFileSync, readdirSync } from 'node:fs';
+import { join } from 'node:path';
+
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+import {
+  ConfigurationError,
+  resolveOperationalInventoryMode,
+} from '../../../src/config/environment';
+import {
+  decodePinRequest,
+  pinInventoryPolicyVersion,
+  samePinExecution,
+} from '../../../src/identity/catalog/pin-contract';
+import {
+  CatalogAdmissionError,
+  admitIdentityContext,
+  bundledRunContext,
+  identityConfiguration,
+  pinRequestFor,
+} from '../../../src/identity/catalog/run-context';
+import {
+  batchInventoryPolicyFor,
+  inventoryPolicyForContext,
+  inventoryPolicyVersionFor,
+} from '../../../src/identity/inventory/model';
+import { CapturingLogger } from '../../../src/logging/logger';
+
+const INSTALLATION = '44444444-4444-4444-8444-444444444444';
+const RUN = '55555555-5555-4555-8555-555555555555';
+
+beforeEach(() => {
+  vi.stubGlobal(
+    'fetch',
+    vi.fn(() => {
+      throw new Error('U10 network forbidden');
+    }),
+  );
+});
+afterEach(() => vi.unstubAllGlobals());
+
+function recordingNamespace(status = 503) {
+  const bodies: unknown[] = [];
+  return {
+    bodies,
+    namespace: {
+      idFromName: (name: string) => name,
+      get: () => ({
+        fetch: async (_url: string, init?: RequestInit) => {
+          bodies.push(JSON.parse(String(init?.body)));
+          return new Response('{}', { status });
+        },
+      }),
+    },
+  };
+}
+
+describe('U10 operational inventory selection (§11.1)', () => {
+  it('accepts optional-drivers only with runtime authority, a UUID installation and a catalog binding', () => {
+    const { namespace } = recordingNamespace();
+    expect(
+      identityConfiguration({
+        IDENTITY_CATALOG_MODE: 'runtime',
+        IDENTITY_INSTALLATION_ID: INSTALLATION,
+        IDENTITY_CATALOG: namespace as never,
+        IDENTITY_INVENTORY_MODE: 'optional-drivers',
+      }).inventoryMode,
+    ).toBe('optional-drivers');
+    const refused = [
+      { IDENTITY_CATALOG_MODE: 'bundled' },
+      { IDENTITY_CATALOG_MODE: 'compare' },
+      { IDENTITY_CATALOG_MODE: 'runtime' },
+      {
+        IDENTITY_CATALOG_MODE: 'runtime',
+        IDENTITY_INSTALLATION_ID: INSTALLATION,
+      },
+      {
+        IDENTITY_CATALOG_MODE: 'runtime',
+        IDENTITY_INSTALLATION_ID: 'not-a-uuid',
+        IDENTITY_CATALOG: namespace,
+      },
+      { IDENTITY_CATALOG_MODE: 'runtime', IDENTITY_CATALOG: namespace },
+    ];
+    for (const env of refused)
+      expect(() =>
+        identityConfiguration({
+          ...env,
+          IDENTITY_INVENTORY_MODE: 'optional-drivers',
+        } as never),
+      ).toThrow(ConfigurationError);
+  });
+
+  it('keeps strict the default and refuses unknown values without falling back', () => {
+    expect(resolveOperationalInventoryMode(undefined, 'runtime')).toBe(
+      'strict',
+    );
+    expect(resolveOperationalInventoryMode('strict', 'compare')).toBe('strict');
+    for (const bad of ['Optional-drivers', 'optional', 'off', ''])
+      expect(() => resolveOperationalInventoryMode(bad, 'runtime')).toThrow(
+        ConfigurationError,
+      );
+  });
+
+  it('admits an optional runtime run only through a schema-2 durable pin request', async () => {
+    const recorder = recordingNamespace(503);
+    await expect(
+      admitIdentityContext(
+        {
+          mode: 'runtime',
+          installationId: INSTALLATION,
+          namespace: recorder.namespace,
+          inventoryMode: 'optional-drivers',
+        },
+        {
+          runId: RUN,
+          season: 2026,
+          purpose: 'manual',
+          leaseFence: 3,
+        },
+        new CapturingLogger(),
+      ),
+    ).rejects.toThrow(CatalogAdmissionError);
+    // Both bounded attempts carried the identical optional request.
+    expect(recorder.bodies).toHaveLength(2);
+    expect(recorder.bodies[0]).toEqual({
+      schemaVersion: 2,
+      runId: RUN,
+      installationId: INSTALLATION,
+      season: 2026,
+      purpose: 'manual',
+      leaseFence: 3,
+      inventoryPolicy: 'optional-driver-inventory-v1',
+    });
+    expect(recorder.bodies[1]).toEqual(recorder.bodies[0]);
+  });
+
+  it('sends the exact pre-U10 schema-1 request for strict runtime runs', async () => {
+    const recorder = recordingNamespace(503);
+    await expect(
+      admitIdentityContext(
+        {
+          mode: 'runtime',
+          installationId: INSTALLATION,
+          namespace: recorder.namespace,
+        },
+        { runId: RUN, season: 2026, purpose: 'scheduled', leaseFence: null },
+        new CapturingLogger(),
+      ),
+    ).rejects.toThrow(CatalogAdmissionError);
+    expect(Object.keys(recorder.bodies[0] as object).sort()).toEqual(
+      [
+        'installationId',
+        'leaseFence',
+        'purpose',
+        'runId',
+        'schemaVersion',
+        'season',
+      ].sort(),
+    );
+    expect(
+      (recorder.bodies[0] as { schemaVersion: number }).schemaVersion,
+    ).toBe(1);
+  });
+
+  it('refuses bundled, compare and unknown inventory modes at admission before any catalog call', async () => {
+    const recorder = recordingNamespace(200);
+    for (const config of [
+      { mode: 'bundled' as const, inventoryMode: 'optional-drivers' as const },
+      { mode: 'compare' as const, inventoryMode: 'optional-drivers' as const },
+      { mode: 'runtime' as const, inventoryMode: 'permissive' as never },
+    ]) {
+      await expect(
+        admitIdentityContext(
+          {
+            ...config,
+            installationId: INSTALLATION,
+            namespace: recorder.namespace,
+          },
+          { runId: RUN, season: 2026, purpose: 'manual', leaseFence: 1 },
+          new CapturingLogger(),
+        ),
+      ).rejects.toMatchObject({ failure: 'catalog-invalid' });
+    }
+    expect(recorder.bodies).toEqual([]);
+  });
+});
+
+describe('U10 durable pin request schemas', () => {
+  const base = {
+    runId: RUN,
+    installationId: INSTALLATION,
+    season: 2026,
+    purpose: 'manual' as const,
+    leaseFence: 1,
+  };
+
+  it('decodes closed schema-1 and schema-2 requests and nothing in between', () => {
+    expect(decodePinRequest({ schemaVersion: 1, ...base })).toEqual({
+      schemaVersion: 1,
+      ...base,
+    });
+    const optional = {
+      schemaVersion: 2,
+      ...base,
+      inventoryPolicy: 'optional-driver-inventory-v1',
+    };
+    expect(decodePinRequest(optional)).toEqual(optional);
+    for (const bad of [
+      { schemaVersion: 2, ...base },
+      { schemaVersion: 2, ...base, inventoryPolicy: 'strict-v1' },
+      {
+        schemaVersion: 1,
+        ...base,
+        inventoryPolicy: 'optional-driver-inventory-v1',
+      },
+      {
+        schemaVersion: 3,
+        ...base,
+        inventoryPolicy: 'optional-driver-inventory-v1',
+      },
+    ])
+      expect(() => decodePinRequest(bad)).toThrow();
+  });
+
+  it('treats the same run ID under another policy as a different execution', () => {
+    const strict = pinRequestFor(base, 'strict/1');
+    const optional = pinRequestFor(base, 'optional-drivers/1');
+    expect(strict).toEqual({ schemaVersion: 1, ...base });
+    expect(samePinExecution(strict, optional)).toBe(false);
+    expect(samePinExecution(optional, { ...optional, leaseFence: 9 })).toBe(
+      true,
+    );
+    expect(pinInventoryPolicyVersion(strict)).toBe('strict/1');
+    expect(pinInventoryPolicyVersion(optional)).toBe('optional-drivers/1');
+  });
+});
+
+describe('U10 policy vocabulary', () => {
+  it('maps run-context and batch vocabularies exactly and closed', () => {
+    expect(batchInventoryPolicyFor('strict/1')).toBe('strict-v1');
+    expect(batchInventoryPolicyFor('optional-drivers/1')).toBe(
+      'optional-driver-inventory-v1',
+    );
+    expect(inventoryPolicyVersionFor('optional-driver-inventory-v1')).toBe(
+      'optional-drivers/1',
+    );
+    for (const bad of ['toString', '__proto__', 'strict', null, 1])
+      expect(batchInventoryPolicyFor(bad)).toBeNull();
+    expect(inventoryPolicyVersionFor('strict')).toBeNull();
+  });
+
+  it('never derives the optional policy from a bundled context, even if relabeled', async () => {
+    const bundled = await bundledRunContext({ runId: RUN, season: 2026 });
+    expect(bundled.inventoryPolicyVersion).toBe('strict/1');
+    expect(() =>
+      inventoryPolicyForContext({
+        ...bundled,
+        inventoryPolicyVersion: 'optional-drivers/1',
+      }),
+    ).toThrow();
+  });
+});
+
+describe('U10 committed environments never select the optional policy (acceptance 37)', () => {
+  it('no wrangler configuration or committed env file sets IDENTITY_INVENTORY_MODE', () => {
+    const root = join(__dirname, '..', '..', '..');
+    const configs = readdirSync(root).filter(
+      (name) => /^wrangler.*\.toml$/.test(name) || /^\.dev\.vars/.test(name),
+    );
+    expect(configs.length).toBeGreaterThan(0);
+    for (const name of configs) {
+      const text = readFileSync(join(root, name), 'utf8');
+      expect(text, name).not.toContain('IDENTITY_INVENTORY_MODE');
+      expect(text, name).not.toContain('optional-drivers');
+    }
+  });
+});
diff --git a/services/edge-api/test/identity/integration/optional-inventory.test.mjs b/services/edge-api/test/identity/integration/optional-inventory.test.mjs
