{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gridview.local/schemas/provider-mappings.schema.json",
  "title": "GridView curated provider-identifier mappings (INTERNAL ONLY)",
  "description": "Season-qualified, source-qualified mappings from an exact provider identifier to an existing GridView public ID. Provider identifiers are internal: they must never appear in a public API fixture, response, OpenAPI example or published snapshot. Structural validity is necessary but not sufficient - composite-key uniqueness and target existence are enforced semantically by scripts/validate-content.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "status", "season", "note", "mappings"],
  "properties": {
    "kind": { "const": "provider-mappings" },
    "schemaVersion": {
      "description": "2 is the source-qualified curated model. Version 1 was a per-provider grouped shape with opaque mock identifiers and is not accepted.",
      "const": 2
    },
    "status": { "$ref": "common.schema.json#/$defs/mockStatus" },
    "note": { "$ref": "#/$defs/boundedText" },
    "season": { "$ref": "common.schema.json#/$defs/season" },
    "mappings": {
      "type": "array",
      "items": { "$ref": "#/$defs/mapping" }
    }
  },
  "$defs": {
    "boundedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "evidence": {
      "description": "Where the exact provider value is already recorded inside this repository. Never a contract, credential or confidential document.",
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "providerString": {
      "description": "Exact upstream string. No control character, no leading or trailing whitespace, never empty. Matched byte-for-byte: no case folding, trimming, slugging or transliteration is ever applied.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[^\\u0000-\\u001F\\u007F\\s](?:[^\\u0000-\\u001F\\u007F]*[^\\u0000-\\u001F\\u007F\\s])?$"
    },
    "providerInteger": {
      "description": "Exact upstream integer. Positive and inside the IEEE-754 safe-integer range.",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "eventLocator": {
      "description": "The complete Jolpica event locator: round, exact raceName and exact Circuit.circuitId together. Every component must match exactly - matching on any proper subset is forbidden, and no fuzzy, slugified, case-folded or punctuation-normalized match exists. It carries NO season: the season is the key's existing qualifier, supplied by the content/seasons/<year>/ file this record lives in, so a locator can never disagree with its own season and then match nothing. additionalProperties:false therefore rejects a redundant inner \"season\". This is a provider locator, not an identity: it is internal, never published and never builds a GridView ID. See docs/adr/0022-curated-provider-identifier-mappings.md amendment A2.",
      "type": "object",
      "additionalProperties": false,
      "required": ["round", "raceName", "circuitId"],
      "properties": {
        "round": { "$ref": "common.schema.json#/$defs/round" },
        "raceName": { "$ref": "#/$defs/providerString" },
        "circuitId": { "$ref": "#/$defs/providerString" }
      }
    },
    "mapping": {
      "description": "One curated mapping. The source, entity kind, provider field and provider value type form a single valid discriminated combination; no other combination is representable.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "entity",
            "providerField",
            "providerValue",
            "gridviewId",
            "evidence"
          ],
          "properties": {
            "source": { "const": "jolpica" },
            "entity": { "const": "driver" },
            "providerField": { "const": "driverId" },
            "providerValue": { "$ref": "#/$defs/providerString" },
            "gridviewId": { "$ref": "common.schema.json#/$defs/slug" },
            "evidence": { "$ref": "#/$defs/evidence" },
            "note": { "$ref": "#/$defs/boundedText" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "entity",
            "providerField",
            "providerValue",
            "gridviewId",
            "evidence"
          ],
          "properties": {
            "source": { "const": "jolpica" },
            "entity": { "const": "constructor" },
            "providerField": { "const": "constructorId" },
            "providerValue": { "$ref": "#/$defs/providerString" },
            "gridviewId": { "$ref": "common.schema.json#/$defs/slug" },
            "evidence": { "$ref": "#/$defs/evidence" },
            "note": { "$ref": "#/$defs/boundedText" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "entity",
            "providerField",
            "providerValue",
            "gridviewId",
            "evidence"
          ],
          "properties": {
            "source": { "const": "jolpica" },
            "entity": { "const": "circuit" },
            "providerField": { "const": "circuitId" },
            "providerValue": { "$ref": "#/$defs/providerString" },
            "gridviewId": { "$ref": "common.schema.json#/$defs/slug" },
            "evidence": { "$ref": "#/$defs/evidence" },
            "note": { "$ref": "#/$defs/boundedText" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "entity",
            "providerField",
            "providerValue",
            "gridviewId",
            "evidence"
          ],
          "properties": {
            "source": { "const": "openf1" },
            "entity": { "const": "driver" },
            "providerField": { "const": "driver_number" },
            "providerValue": { "$ref": "#/$defs/providerInteger" },
            "gridviewId": { "$ref": "common.schema.json#/$defs/slug" },
            "evidence": { "$ref": "#/$defs/evidence" },
            "note": { "$ref": "#/$defs/boundedText" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "entity",
            "providerField",
            "providerValue",
            "gridviewId",
            "evidence"
          ],
          "properties": {
            "source": { "const": "openf1" },
            "entity": { "const": "constructor" },
            "providerField": { "const": "team_name" },
            "providerValue": { "$ref": "#/$defs/providerString" },
            "gridviewId": { "$ref": "common.schema.json#/$defs/slug" },
            "evidence": { "$ref": "#/$defs/evidence" },
            "note": { "$ref": "#/$defs/boundedText" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "entity",
            "providerField",
            "providerValue",
            "gridviewId",
            "evidence"
          ],
          "properties": {
            "source": { "const": "openf1" },
            "entity": { "const": "circuit" },
            "providerField": { "const": "circuit_key" },
            "providerValue": { "$ref": "#/$defs/providerInteger" },
            "gridviewId": { "$ref": "common.schema.json#/$defs/slug" },
            "evidence": { "$ref": "#/$defs/evidence" },
            "note": { "$ref": "#/$defs/boundedText" }
          }
        },
        {
          "description": "The one event combination. \"eventLocator\" is GridView's own name for the composite locator, because Jolpica publishes no event identifier and the locator spans three Jolpica fields at once. \"gridviewId\" is an eventSlug that must already exist in the curated event registry; it is never a GrandPrix.id. There is no OpenF1 event combination.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "entity",
            "providerField",
            "providerValue",
            "gridviewId",
            "evidence"
          ],
          "properties": {
            "source": { "const": "jolpica" },
            "entity": { "const": "event" },
            "providerField": { "const": "eventLocator" },
            "providerValue": { "$ref": "#/$defs/eventLocator" },
            "gridviewId": { "$ref": "common.schema.json#/$defs/slug" },
            "evidence": { "$ref": "#/$defs/evidence" },
            "note": { "$ref": "#/$defs/boundedText" }
          }
        }
      ]
    }
  }
}
